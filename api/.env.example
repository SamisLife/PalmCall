# Copy to .env and fill in.  .env is gitignored — never commit the real key.

# Team key from the VOYGR spreadsheet "Keys" tab (pk_live_...).
CALLWRIGHT_API_KEY=

# Safety switch. 1 = print the payload, simulate the call, dial NOTHING.
# Set to 0 only when you actually want a real phone to ring.
CALLWRIGHT_DRY_RUN=

# Every real call is hard-capped to numbers in this list (E.164, comma separated).
# Leave empty to disable the guard. Keep your own cell here during the hackathon
# so a bug can never dial a stranger.
CALLWRIGHT_ALLOWED_NUMBER=

# Demo targets
CAREGIVER_PRIMARY_PHONE=
CAREGIVER_BACKUP_PHONE=
ERRAND_PHONE=
